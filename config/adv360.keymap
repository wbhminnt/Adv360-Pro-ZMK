#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        ejectDBLTap: ejectDBLTap {
            compatible = "zmk,behavior-tap-dance";
            label = "EJECTDBLTAP";
            #binding-cells = <0>;
            bindings = <&none>, <&kp LG(LA(C_EJECT))>;
        };

        deleteTD: deleteTD {
            compatible = "zmk,behavior-tap-dance";
            label = "DELETETD";
            #binding-cells = <0>;
            bindings = <&lt 1 BACKSPACE>, <&kp LA(BACKSPACE)>;

            tapping-term-ms = <170>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "home_row_mod_left";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 13 7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        dbltaptobase: dbltaptobase {
            compatible = "zmk,behavior-tap-dance";
            label = "DBLTAPTOBASE";
            #binding-cells = <0>;
            bindings = <&none>, <&to 0>;
        };
    };

    macros {
        triple_backtick: triple_backtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE>;
            label = "TRIPLE_BACKTICK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp EQUAL         &kp N1               &kp N2           &kp N3           &kp N4             &kp N5  &kp PLUS                                                         &mo 5      &kp N6  &kp N7              &kp N8            &kp N9            &kp N0                    &kp RA(S)
&kp TAB           &kp Q                &kp W            &kp E            &kp R              &kp T   &kp EQUAL                                                        &kp COLON  &kp Z   &kp U               &kp I             &kp O             &kp P                     &kp RA(U)
&kp ESC           &hml LEFT_CONTROL A  &hml LEFT_ALT S  &hml LEFT_GUI D  &hml LEFT_SHIFT F  &kp G   &kp MINUS  &none      &none               &none       &none      &kp SEMI   &kp H   &hmr RIGHT_SHIFT J  &hmr RIGHT_GUI K  &hmr RIGHT_ALT L  &hmr RIGHT_CONTROL RA(O)  &kp RA(A)
&kp LSHFT         &kp Y                &kp X            &kp C            &kp V              &kp B                         &none               &none                             &kp N   &kp M               &kp COMMA         &kp DOT           &kp MINUS                 &kp RSHFT
&kp LEFT_CONTROL  &kp LEFT_ALT         &kp LEFT_GUI     &mo 2            &lt 1 SPACE                &kp SPACE  &deleteTD  &lt 5 QUESTION      &lt 4 EXCL  &kp SLASH  &kp ENTER          &lt 3 BACKSPACE     &kp LEFT_ARROW    &kp DOWN_ARROW    &kp UP_ARROW              &kp RIGHT
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &trans  &none               &none               &none                &none                &none  &ejectDBLTap
&none  &none  &none  &none  &none  &none  &none                                  &none   &none               &kp PAGE_DOWN       &kp PAGE_UP          &none                &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none   &kp LEFT_ARROW      &kp DOWN_ARROW      &kp UP_ARROW         &kp RIGHT            &none  &kp PG_UP
&none  &none  &none  &none  &none  &none                &none      &none                 &kp LG(LEFT_ARROW)  &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &kp LG(RIGHT_ARROW)  &none  &kp PG_DN
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none                       &none               &none                &none                &none  &none
            >;
        };

        num {
            display-name = "Num";
            bindings = <
&trans  &trans  &trans  &trans            &trans  &trans  &trans                                             &trans           &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &kp RA(NUMBER_5)  &trans  &trans  &trans                                             &trans           &trans  &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans  &trans
&trans  &trans  &trans  &kp DLLR          &trans  &trans  &trans  &trans  &trans      &trans     &trans      &trans           &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &trans  &trans
&trans  &trans  &trans  &trans            &trans  &trans                  &trans      &trans                                  &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &trans  &trans
&trans  &trans  &trans  &trans            &trans          &trans  &trans  &trans      &kp COMMA  &kp PERIOD  &kp KP_NUMBER_0          &trans     &trans     &trans     &trans  &trans
            >;
        };

        symbol {
            display-name = "Symbol";
            bindings = <
&triple_backtick  &kp GRAVE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMI          &kp PERCENT  &trans                                                    &trans         &none      &none         &none         &none         &none             &none
&kp EXCL          &kp LEFT_BRACE  &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES      &kp RIGHT_BRACE   &kp QMARK    &trans                                                    &trans         &kp ASTRK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp BACKSLASH     &kp BACKSPACE
&kp HASH          &kp CARET       &kp UNDERSCORE        &kp EQUAL              &kp DOLLAR        &kp ASTRK    &trans     &trans         &trans      &trans   &trans     &trans         &kp AT     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES
&kp TILDE         &kp LESS_THAN   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp GREATER_THAN  &kp SLASH                              &trans      &trans                             &kp TILDE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS         &kp UNDERSCORE
&kp RA(NUMBER_5)  &kp AMPS        &kp PIPE              &kp MINUS              &kp PLUS                       &kp COLON  &kp BACKSLASH  &kp AT      &kp DOT  &kp COMMA  &kp SEMICOLON             &trans        &kp NUMBER_0  &none         &none             &none
            >;
        };

        f_keys {
            bindings = <
&trans  &trans  &kp F10  &kp F11  &kp F12  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F7   &kp F8   &kp F9   &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F4   &kp F5   &kp F6   &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F1   &kp F2   &kp F3   &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans   &trans   &trans           &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            label = "F_Keys";
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &kp LG(LA(C_EJECT))  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader          &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT         &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                        &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG             &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp F   &kp P   &kp B   &trans                                             &trans  &kp J   &kp L   &kp U   &kp Y   &trans  &trans
&trans  &trans  &kp R   &kp S   &kp T   &trans  &trans  &trans  &trans             &trans  &trans  &trans  &kp M   &kp N   &kp E   &kp I   &kp O   &trans
&trans  &kp Z   &trans  &trans  &kp D   &kp V                   &trans             &trans                  &kp K   &kp H   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &dbltaptobase      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
